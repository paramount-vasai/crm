{
 "name": "Paramount CRM",
 "short_name": "Paramount CRM",
 "start_url": "./",
 "scope": "./",
 "display": "standalone",
 "background_color": "#123b6b",
 "theme_color": "#123b6b",
 "icons": [
  {
   "src": "icon-192.png",
   "sizes": "192x192",
   "type": "image/png"
  },
  {
   "src": "icon-512.png",
   "sizes": "512x512",
   "type": "image/png",
   "purpose": "any maskable"
  }
 ],
 "share_target": {
  "action": "./share-target",
  "method": "POST",
  "enctype": "multipart/form-data",
  "params": {
   "title": "title",
   "text": "text",
   "files": [
    {
     "name": "files",
     "accept": [
      "application/pdf",
      ".pdf",
      "image/*",
      ".doc",
      ".docx",
      ".xls",
      ".xlsx",
      "application/*"
     ]
    }
   ]
  }
 }
}